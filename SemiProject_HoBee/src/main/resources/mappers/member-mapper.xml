<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="hobee.semi.project.member.model.mapper.MemberMapper">

		<select id="loginMember" resultType="MemberDTO">
			SELECT
			MEMBER_NO,MEMBER_EMAIL,MEMBER_ID,MEMBER_PW,MEMBER_NICKNAME,
			MEMBER_TEL,MEMBER_ADDRESS,ENROLL_DATE,AUTHOR_LEVEL,MEMBER_DEL_FL
			FROM "MEMBER"
			WHERE MEMBER_ID = #{memberId}
		</select>
		
		<select id="checkEmail" resultType="_int">
			SELECT COUNT(*)
			FROM "MEMBER"
			WHERE MEMBER_EMAIL = #{memberEmail}
			AND MEMBER_DEL_FL = 'N'
		</select>
		
		<select id="checkId" resultType="_int">
			SELECT COUNT(*)
			FROM "MEMBER"
			WHERE MEMBER_ID = #{memberId}
			AND MEMBER_DEL_FL = 'N'
		</select>








</mapper>
