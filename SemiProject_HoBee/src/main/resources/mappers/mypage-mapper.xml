<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="hobee.semi.project.myPage.model.mapper.MyPageMapper">

	<!-- 회원 정보 수정 -->
	<update id="updateInfo">
		UPDATE "MEMBER" SET
		MEMBER_NICKNAME = #{memberNickname},
		MEMBER_TEL = #{memberTel},
		MEMBER_ADDRESS = #{memberAddress}
		MEMBER_INTRODUCTION = #{memberIntroduction}
		WHERE MEMBER_NO = #{memberNo}
	</update>

	<!-- 비밀번호 확인 -->
	<select id="checkPw">
		SELECT MEMBER_PW
		FROM "MEMBER"
		WHERE MEMBER_NO = #{memberNo}
	</select>
	
	<!-- 비밀번호 변경 -->
	<update id="changePw">
		UPDATE "MEMBER" SET
		MEMBER_PW = #{memberPw}
		WHERE MEMBER_NO = #{memberNo}
	</update>	
	
	<!-- 선택한 취미 목록 조회 -->
	<select id="selectHobbyList"
        parameterType="list"
        resultType="Hobby">
		SELECT HOBBY_CODE, HOBBY_NAME
    		FROM HOBBY
    		WHERE HOBBY_CODE IN
    		<foreach collection="list" item="code"
             open="(" separator="," close=")">
        #{code}
		</foreach>
	</select>

	<!-- 기존 취미 삭제 -->
	<delete id="deleteMemberHobby">
  		DELETE FROM MEMBER_HOBBY
  		WHERE MEMBER_NO = #{memberNo}
	</delete>

	<!-- 취미 추가 -->
	<insert id="insertMemberHobby">
  		INSERT INTO MEMBER_HOBBY (MEMBER_NO, HOBBY_CODE)
  		VALUES <foreach collection="hobbyCode" item="code" separator=",">
  		(#{memberNo}, #{hobbyCode}) </foreach>
	</insert>
	
	
</mapper>
